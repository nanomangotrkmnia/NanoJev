# ---- Minecraft connection ----
# Full server address: host or host:port, e.g. play.example.net:25617.
# MC_ADDRESS takes precedence over MC_HOST and MC_PORT when it contains a port.
MC_ADDRESS=
# Or set host and port separately.
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=NanoJev
# offline | microsoft
MC_AUTH=offline
# Only used for some legacy offline setups; leave empty for microsoft (device-code flow).
MC_PASSWORD=
# "auto" detects the server version from its ping. Or pin a tested version, e.g. 1.21.4
MC_VERSION=auto
MC_CONNECT_TIMEOUT_MS=30000

# ---- Reconnection ----
MC_RECONNECT=true
MC_RECONNECT_MAX_ATTEMPTS=5
MC_RECONNECT_BASE_DELAY_MS=2000
MC_RECONNECT_MAX_DELAY_MS=60000

# ---- Target selection ----
# Leave MC_TARGET empty to auto-target the nearest eligible player.
MC_TARGET=
# explicit | nearest (defaults to explicit when MC_TARGET is set, else nearest)
MC_TARGET_MODE=
MC_TARGET_RANGE=32

# ---- Decision backend ----
# typesafe | openjev | codiv
#   typesafe = TypeSafe's hosted Jev (TYPESAFE_API_KEY)
#   openjev  = a local OpenJev server you run (run-openjev.bat)
#   codiv    = Codiv's hosted OpenJev at https://api.codiv.ai (OPENJEV_API_KEY = sk-codiv-...)
NANOJEV_JEV_BACKEND=typesafe

# ---- TypeSafe Jev (cloud) ----
# Create a key at https://console.typesafe.ai and paste it here. Never commit this file.
TYPESAFE_API_KEY=
# Optional override of the API root (defaults to https://api.typesafe.ai).
TYPESAFE_BASE_URL=
JEV_MODEL=jev-latest

# ---- OpenJev (local server, or hosted on Codiv) ----
# Local OpenJev default: http://127.0.0.1:8080 (see run-openjev.bat)
# Codiv (hosted OpenJev): https://api.codiv.ai with OPENJEV_HOSTED=true and an sk-codiv-... key
OPENJEV_BASE_URL=http://127.0.0.1:8080
OPENJEV_API_KEY=
# Model id: openjev-latest | laya-1.0 | verdict-1.4 | clm-v0.1 | jevk5-0.3 | clef-1.0 | clef-flash-1.0
OPENJEV_MODEL=openjev-latest
OPENJEV_HOSTED=false

JEV_TIMEOUT_MS=5000
JEV_MAX_RETRIES=2
# halt | hold  (halt = stop initiating combat actions while Jev is unavailable)
NANOJEV_ON_JEV_FAILURE=halt

# ---- Combat loop tuning ----
NANOJEV_LOG_LEVEL=info
NANOJEV_LOOP_HZ=20
NANOJEV_DECISION_MIN_INTERVAL_MS=250
NANOJEV_DECISION_TIMEOUT_MS=3000
# Approximate attack cooldown in ms (modern full-charge sword swing ~625 ms). Not read from the protocol.
NANOJEV_ATTACK_INTERVAL_MS=625
NANOJEV_ATTACK_RANGE=3
NANOJEV_STRAFE_RANGE=6
NANOJEV_RETREAT_HEALTH_FRACTION=0.5
NANOJEV_MATERIAL_DISTANCE_BUCKET=1
# Offer a W-tap (sprint reset) as a selectable attack the model can choose.
NANOJEV_WTAP_ENABLED=true
# How many ticks to hold the release phase of a W-tap (1 tick = 50 ms at 20 tps).
NANOJEV_WTAP_RELEASE_TICKS=2
